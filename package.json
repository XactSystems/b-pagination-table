{
  "name": "@xactsystems/b-pagination-table",
  "version": "4.0.0",
  "license": "MIT",
  "description": "A pagination table for BootstrapVueNext with AJAX fetch and server side pagination options.",
  "type": "module",
  "files": [
    "dist",
    "src/"
  ],
  "main": "dist/b-pagination-table.umd.cjs",
  "module": "dist/b-pagination-table.js",
  "exports": {
    ".": {
      "import": "./dist/b-pagination-table.js",
      "require": "./dist/b-pagination-table.umd.cjs"
    }
  },
  "main-dev": "src/index.js",
  "keywords": [
    "bootstrap",
    "bootstrap-vue-next",
    "vue",
    "component",
    "table",
    "grid",
    "b-table",
    "pagination",
    "b-pagination",
    "ajax",
    "axios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XactSystems/b-pagination-table.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "eslint --fix src",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "globals": "^17.13.0"
  },
  "peerDependencies": {
    "bootstrap": "^5.3",
    "bootstrap-vue-next": "^1.2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0",
    "@vitejs/plugin-vue": "^6.0",
    "eslint": "^10.0",
    "eslint-plugin-vue": "^10.11",
    "unplugin-vue-components": "^32.1",
    "vite": "^8.0",
    "vite-plugin-eslint": "^1.8"
  },
  "engines": {
    "node": "*"
  }
}
